# Required for stable signed sessions across Vercel function instances.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETVIZ_SECRET_KEY=replace-with-a-long-random-secret

# Vercel serves the application over HTTPS.
NETVIZ_HTTPS_ONLY=1

# Optional local override. Do not point this at the read-only Vercel bundle.
# NETVIZ_DATABASE=/absolute/path/to/netviz.db
